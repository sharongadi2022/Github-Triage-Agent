# GitHub personal access token (needs "repo" scope to apply labels)
GITHUB_TOKEN=ghp_your_token_here
# Repository to triage, in owner/name form
GITHUB_REPO=owner/repo
# Local model served by Ollama (run: ollama pull llama3.1)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# Seconds between polling runs
POLL_INTERVAL=300
# Decisions below this confidence are flagged for a human instead of applied
CONFIDENCE_THRESHOLD=0.6
# Extra confidence needed to overturn an earlier decision (stops flip-flopping)
OVERTURN_MARGIN=0.15
# true = decide and log, but do not write labels to GitHub
DRY_RUN=true
DB_PATH=triage_memory.db
